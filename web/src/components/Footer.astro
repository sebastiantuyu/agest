---
const base = import.meta.env.BASE_URL;
const llms = (base.endsWith("/") ? base : base + "/") + "llms.txt";
---

  <!-- Footer -->
  <footer class="layer border-t border-[var(--line)]">
    <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--ink-faint)] font-mono">
      <span>agest by <a href="https://sebastiantuyu.com" target="_blank" rel="noopener" class="text-[var(--ink-dim)] hover:text-[var(--ink)] transition-colors">sebastiantuyu</a> · MIT · © 2026</span>
      <div class="flex gap-6">
        <a href="https://github.com/sebastiantuyu/agest" target="_blank" rel="noopener" class="hover:text-[var(--ink)] transition-colors">GitHub</a>
        <a href="https://www.npmjs.com/package/@sebastiantuyu/agest" target="_blank" rel="noopener" class="hover:text-[var(--ink)] transition-colors">npm</a>
        <a href={llms} class="hover:text-[var(--ink)] transition-colors">llms.txt</a>
      </div>
    </div>
  </footer>
