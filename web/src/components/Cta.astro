    <!-- CTA — launch -->
    <section class="max-w-6xl mx-auto px-6 pb-24">
      <div class="cta-panel">
        <!-- pixel starfield -->
        <div class="cta-stars" aria-hidden="true">
          <i style="left:6%;top:20%"></i>
          <i class="b" style="left:13%;top:62%"></i>
          <i class="tw" style="left:20%;top:34%"></i>
          <i class="s" style="left:9%;top:80%"></i>
          <i style="left:27%;top:14%"></i>
          <i class="b" style="left:33%;top:74%"></i>
          <i class="tw s" style="left:40%;top:46%"></i>
          <i style="left:47%;top:22%"></i>
          <i class="b" style="left:55%;top:84%"></i>
          <i class="tw" style="left:62%;top:30%"></i>
          <i style="left:69%;top:66%"></i>
          <i class="s" style="left:76%;top:18%"></i>
          <i class="b" style="left:83%;top:52%"></i>
          <i class="tw" style="left:90%;top:38%"></i>
          <i style="left:94%;top:74%"></i>
        </div>

        <div class="relative z-[1] grid lg:grid-cols-[0.8fr_1fr] items-center gap-8 lg:gap-12">
          <!-- pixel-art rocket -->
          <div class="cta-scene">
            <svg class="rocket" viewBox="0 0 24 34" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <!-- nose -->
              <rect x="11" y="0" width="2" height="1" fill="#6ee7a8" />
              <rect x="10" y="1" width="4" height="2" fill="#d8f99a" />
              <rect x="9" y="3" width="6" height="2" fill="#d8f99a" />
              <rect x="8" y="5" width="8" height="1" fill="#d8f99a" />
              <!-- body -->
              <rect x="8" y="6" width="8" height="18" fill="#bef264" />
              <rect x="8" y="6" width="1" height="18" fill="#d8f99a" />
              <rect x="15" y="6" width="1" height="18" fill="#8fbf45" />
              <!-- band -->
              <rect x="8" y="15" width="8" height="2" fill="#6f8f37" />
              <rect x="8" y="15" width="1" height="2" fill="#97b84a" />
              <!-- window -->
              <rect x="10" y="9" width="4" height="4" fill="#0a140f" />
              <rect x="11" y="10" width="2" height="2" fill="#fcd34d" />
              <rect x="11" y="10" width="1" height="1" fill="#ffffff" />
              <!-- rivets -->
              <rect x="9" y="20" width="1" height="1" fill="#8fbf45" />
              <rect x="14" y="20" width="1" height="1" fill="#8fbf45" />
              <!-- fins -->
              <rect x="6" y="18" width="2" height="1" fill="#97b84a" />
              <rect x="5" y="19" width="3" height="2" fill="#97b84a" />
              <rect x="4" y="21" width="4" height="3" fill="#97b84a" />
              <rect x="16" y="18" width="2" height="1" fill="#97b84a" />
              <rect x="16" y="19" width="3" height="2" fill="#97b84a" />
              <rect x="16" y="21" width="4" height="3" fill="#97b84a" />
              <rect x="19" y="21" width="1" height="3" fill="#6f8f37" />
              <!-- nozzle -->
              <rect x="9" y="24" width="6" height="1" fill="#6f8f37" />
              <rect x="10" y="25" width="4" height="1" fill="#46682a" />
              <!-- flames (flicker between two shapes) -->
              <g class="flame-a">
                <rect x="9" y="26" width="6" height="1" fill="#f59e0b" />
                <rect x="10" y="27" width="4" height="1" fill="#fcd34d" />
                <rect x="11" y="27" width="2" height="1" fill="#ffffff" />
                <rect x="10" y="28" width="4" height="1" fill="#fcd34d" />
                <rect x="11" y="29" width="2" height="1" fill="#f59e0b" />
                <rect x="11" y="30" width="1" height="1" fill="#f59e0b" />
              </g>
              <g class="flame-b">
                <rect x="9" y="26" width="6" height="1" fill="#fcd34d" />
                <rect x="10" y="26" width="4" height="1" fill="#ffffff" />
                <rect x="9" y="27" width="6" height="1" fill="#f59e0b" />
                <rect x="10" y="28" width="4" height="1" fill="#fcd34d" />
                <rect x="11" y="29" width="2" height="1" fill="#f59e0b" />
              </g>
            </svg>
          </div>

          <!-- copy -->
          <div class="text-center lg:text-left">
            <h2 class="pix text-[16px] sm:text-[24px] leading-relaxed">put a number on <span class="text-signal">good</span></h2>
            <p class="mt-5 text-[16px] text-[var(--ink-dim)] max-w-lg mx-auto lg:mx-0">
              Clear your bar, then ship it. Add a quality gate to your agent in one install.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start items-center">
              <div class="install rounded-lg px-4 h-[48px] font-mono text-[14px] text-[var(--ink-dim)] flex items-center gap-3.5">
                <span class="text-signal/60 select-none">$</span>
                <span>npm i -D @agest/core</span>
                <button class="copy-btn ml-auto" onclick="navigator.clipboard.writeText('npm i -D @agest/core'); this.textContent='copied'; setTimeout(() => this.textContent='copy', 1500)">copy</button>
              </div>
              <a href="https://github.com/sebastiantuyu/agest" target="_blank" rel="noopener" class="btn-primary px-5 h-[48px]">
                <svg class="gico-btn" viewBox="0 0 7 7" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true"><rect x="3" y="0" width="1" height="2"/><rect x="0" y="2" width="7" height="1"/><rect x="1" y="3" width="5" height="1"/><rect x="2" y="4" width="3" height="1"/><rect x="1" y="5" width="2" height="1"/><rect x="4" y="5" width="2" height="1"/><rect x="0" y="6" width="1" height="1"/><rect x="6" y="6" width="1" height="1"/></svg>
                star on github
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
