    <!-- The loop: the tuning loop (datasheet diagram) -->
    <section id="loop" class="max-w-6xl mx-auto px-6 pt-4 pb-20 reveal" aria-labelledby="loop-h">
      <div class="text-center mb-10">
        <h2 id="loop-h" class="pix text-signal text-[15px] sm:text-[21px]">&gt; THE LOOP</h2>
        <p class="mt-5 text-[15px] sm:text-[16px] text-[var(--ink-dim)] max-w-2xl mx-auto leading-relaxed">
          Building agents costs money &mdash; agest faces it. Spend the tokens once, measure
          <span class="text-[var(--ink)]">everything</span>, refine against your bar, repeat.
        </p>
      </div>

      <div class="console">
        <!-- figure caption -->
        <div class="console-bar">
          <span class="pix text-[9px] text-[var(--ink-dim)]">FIG.01 · THE TUNING LOOP</span>
          <span class="font-mono text-[10px] text-[var(--ink-faint)] ml-auto">cost in &rarr; signal out</span>
        </div>

        <div class="p-5 sm:p-7">
          <!-- pipeline: build → run → measure → refine -->
          <div class="flex flex-col lg:flex-row lg:items-stretch gap-2.5 lg:gap-0">
            <article class="stage">
              <div class="stage-head">
                <svg class="picon" viewBox="0 0 16 16" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g fill="#97b84a"><rect x="6" y="0" width="4" height="2"/><rect x="6" y="14" width="4" height="2"/><rect x="0" y="6" width="2" height="4"/><rect x="14" y="6" width="2" height="4"/><rect x="2" y="2" width="2" height="2"/><rect x="12" y="2" width="2" height="2"/><rect x="2" y="12" width="2" height="2"/><rect x="12" y="12" width="2" height="2"/></g><g fill="#bef264"><rect x="6" y="3" width="4" height="1"/><rect x="5" y="4" width="6" height="1"/><rect x="4" y="5" width="8" height="1"/><rect x="3" y="6" width="10" height="4"/><rect x="4" y="10" width="8" height="1"/><rect x="5" y="11" width="6" height="1"/><rect x="6" y="12" width="4" height="1"/></g><rect x="6" y="6" width="4" height="4" fill="#0e0e11"/><g fill="#d8f99a"><rect x="4" y="5" width="3" height="1"/><rect x="3" y="6" width="1" height="2"/></g></svg>
                <span class="step">01</span>
              </div>
              <span class="name">BUILD</span>
              <p class="desc">Define the agent &mdash; and the bar it has to clear.</p>
              <span class="tag">agest.config.ts</span>
            </article>

            <div class="flow-arrow rotate-90 lg:rotate-0" aria-hidden="true">▶</div>

            <article class="stage">
              <div class="stage-head">
                <svg class="picon" viewBox="0 0 16 16" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g fill="#bef264"><rect x="4" y="3" width="2" height="1"/><rect x="4" y="4" width="3" height="1"/><rect x="4" y="5" width="4" height="1"/><rect x="4" y="6" width="5" height="1"/><rect x="4" y="7" width="6" height="1"/><rect x="4" y="8" width="7" height="1"/><rect x="4" y="9" width="6" height="1"/><rect x="4" y="10" width="5" height="1"/><rect x="4" y="11" width="4" height="1"/><rect x="4" y="12" width="3" height="1"/><rect x="4" y="13" width="2" height="1"/></g><rect x="4" y="3" width="1" height="11" fill="#d8f99a"/><g fill="#8fbf45"><rect x="9" y="7" width="1" height="1"/><rect x="10" y="8" width="1" height="1"/><rect x="9" y="9" width="1" height="1"/></g></svg>
                <span class="step">02</span>
              </div>
              <span class="name">RUN</span>
              <p class="desc">Run the suite for real. The tokens get spent either way.</p>
              <span class="tag">agest.runs(n)</span>
            </article>

            <div class="flow-arrow rotate-90 lg:rotate-0" aria-hidden="true">▶</div>

            <article class="stage key">
              <div class="stage-head">
                <svg class="picon" viewBox="0 0 16 16" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="2" y="14" width="12" height="1" fill="#44824d"/><rect x="2" y="9" width="3" height="5" fill="#97b84a"/><rect x="6" y="6" width="3" height="8" fill="#bef264"/><rect x="10" y="3" width="3" height="11" fill="#6ee7a8"/><rect x="2" y="9" width="3" height="1" fill="#b7d96a"/><rect x="6" y="6" width="3" height="1" fill="#d8f99a"/><rect x="10" y="3" width="3" height="1" fill="#aef0c4"/></svg>
                <span class="step">03</span>
              </div>
              <span class="name">MEASURE</span>
              <p class="desc">That one paid run hands back the whole readout &mdash; not a pass/fail.</p>
              <span class="tag">coverage · ci · cost</span>
            </article>

            <div class="flow-arrow rotate-90 lg:rotate-0" aria-hidden="true">▶</div>

            <article class="stage">
              <div class="stage-head">
                <svg class="picon" viewBox="0 0 16 16" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g fill="#44824d"><rect x="2" y="4" width="12" height="1"/><rect x="2" y="8" width="12" height="1"/><rect x="2" y="12" width="12" height="1"/></g><g fill="#bef264"><rect x="9" y="2" width="3" height="5"/><rect x="4" y="6" width="3" height="5"/><rect x="11" y="10" width="3" height="5"/></g><g fill="#d8f99a"><rect x="9" y="2" width="3" height="1"/><rect x="4" y="6" width="3" height="1"/><rect x="11" y="10" width="3" height="1"/></g></svg>
                <span class="step">04</span>
              </div>
              <span class="name">REFINE</span>
              <p class="desc">Change one dimension; the numbers tell you what moved.</p>
              <span class="tag">model · prompt · tools</span>
            </article>
          </div>

          <!-- loop back to BUILD -->
          <div class="loopback hidden lg:block mt-1" aria-hidden="true">
            <span class="loopback-label"><b>↻ refine &amp; re-run</b> &mdash; every loop scored against your bar</span>
          </div>
          <p class="lg:hidden mt-3 text-center font-mono text-[11px] text-[var(--ink-faint)]">
            <span class="text-signal/80">↻ refine &amp; re-run</span> &mdash; scored against your bar
          </p>

          <!-- secondary: what a run returns -->
          <div class="mt-7 lg:mt-9 pt-6 border-t border-[var(--line)]">
            <div class="flex items-center justify-between gap-3 mb-3.5">
              <span class="font-mono text-[10px] tracking-[0.14em] uppercase text-[var(--ink-faint)]">what one paid run returns</span>
              <span class="run-tag">BUILT-IN · $0 EXTRA</span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <div class="metric">
                <div class="metric-top"><span class="mk">COV</span><span class="mv">82%</span></div>
                <div class="bar"><div class="bar-fill" style="width:82%"></div><div class="bar-thresh" style="left:85%"></div><div class="bar-seg"></div></div>
              </div>
              <div class="metric">
                <div class="metric-top"><span class="mk">ACC</span><span class="mv">94%<span class="ok">✓</span></span></div>
                <div class="bar"><div class="bar-fill good" style="width:94%"></div><div class="bar-thresh" style="left:90%"></div><div class="bar-seg"></div></div>
              </div>
              <div class="metric">
                <div class="metric-top"><span class="mk">COST</span><span class="mv">$.002<span class="ok">✓</span></span></div>
                <div class="bar"><div class="bar-fill warn good" style="width:17%"></div><div class="bar-thresh" style="left:35%"></div><div class="bar-seg"></div></div>
              </div>
              <div class="metric">
                <div class="metric-top"><span class="mk">SPEED</span><span class="mv">3.4s<span class="ok">✓</span></span></div>
                <div class="bar"><div class="bar-fill good" style="width:88%"></div><div class="bar-thresh" style="left:84%"></div><div class="bar-seg"></div></div>
              </div>
            </div>

            <div class="flex items-center gap-3 mt-5 mb-2.5">
              <span class="font-mono text-[10px] tracking-[0.14em] uppercase text-[var(--ink-faint)]">same run also writes</span>
              <span class="dot-rule flex-1"></span>
            </div>
            <div class="artifacts">
              <span class="artifact"><span class="ico">▤</span>scored report</span>
              <span class="artifact"><span class="ico">◈</span>coverage radar</span>
              <span class="artifact"><span class="ico">±</span>wilson 95% ci</span>
              <span class="artifact"><span class="ico">$</span>cost waterfall</span>
              <span class="artifact"><span class="ico">Δ</span>run-history diff</span>
              <span class="artifact"><span class="ico">⏻</span>ci exit gate</span>
            </div>
          </div>
        </div>
      </div>

      <p class="text-center mt-12 text-[14.5px] text-[var(--ink-faint)]">
        Syntax, assertions, reports &amp; roadmap &rarr;
        <a href="docs/index.html" class="text-signal hover:underline">read the docs</a>
      </p>
    </section>
