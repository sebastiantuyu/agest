---
const base = import.meta.env.BASE_URL;
const root = base.endsWith("/") ? base : base + "/";

const logos = [
  { name: "smashmedia", src: root + "logos/smashmedia.png", href: "https://smashmedia.com" },
  { name: "trailly", src: root + "logos/trailly.png", href: "https://trailly.io" },
  { name: "padclaw", src: root + "logos/padclaw.png", href: "https://padclaw.app" },
  { name: "wedbook", src: root + "logos/wedbook.svg", href: "https://wedbook.ai" },
  { name: "vitalitas", src: root + "logos/vitalitas.png", href: "https://vitalitas.mx" },
];
---

<!-- Trusted by -->
<section id="trust" class="max-w-6xl mx-auto px-6 pt-4 pb-16 reveal" aria-labelledby="trust-h">
  <div class="text-center mb-9">
    <h2 id="trust-h" class="pix text-signal text-[13px] sm:text-[17px]">&gt; TRUSTED BY</h2>
    <p class="mt-4 text-[14px] sm:text-[15px] text-[var(--ink-dim)] max-w-xl mx-auto leading-relaxed">
      Teams shipping agents they can actually <span class="text-[var(--ink)]">measure</span>.
    </p>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-x-14 sm:gap-x-20 gap-y-10">
    {
      logos.map((l) => (
        <a href={l.href} target="_blank" rel="noopener" class="trust-item" aria-label={l.name}>
          <img src={l.src} alt={`${l.name} logo`} width="76" height="76" loading="lazy" decoding="async" class="trust-logo" />
        </a>
      ))
    }
  </div>
</section>
