---
import Base from "../../layouts/Base.astro";
import DocsNav from "../../components/docs/DocsNav.astro";
import Footer from "../../components/Footer.astro";
import Cta from "../../components/Cta.astro";

import syntax from "../../components/docs/syntax.html?raw";
import capabilities from "../../components/docs/capabilities.html?raw";
import reports from "../../components/docs/reports.html?raw";
import faq from "../../components/docs/faq.html?raw";
import roadmap from "../../components/docs/roadmap.html?raw";

import brailleJs from "../../components/docs/braille-radar.js?raw";
import chartsJs from "../../components/docs/charts.js?raw";
---

<Base
  title="agest · Documentation — syntax, assertions & reports"
  description="agest documentation: scene syntax, the assertion/matcher catalog, visual and CLI reports, and the roadmap. Quantitative testing for AI agents."
  canonical="https://sebastiantuyu.github.io/agest/docs/"
  ogUrl="https://sebastiantuyu.github.io/agest/docs/"
  faq={true}
>
  <Fragment slot="head">
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  </Fragment>

  <DocsNav />

  <header class="layer max-w-6xl mx-auto px-6 pt-14 pb-8 text-center">
    <h1 class="pix text-signal text-[14px] sm:text-[18px]">agest docs</h1>
    <p class="mt-5 text-[15px] text-[var(--ink-dim)] max-w-xl mx-auto leading-relaxed">
      Scene syntax, the assertion catalog, visual + CLI reports, and the roadmap — the reference for
      <span class="text-[var(--ink)]">@sebastiantuyu/agest</span>.
    </p>
  </header>

  <main class="layer">
    <Fragment set:html={syntax} />
    <Fragment set:html={capabilities} />
    <Fragment set:html={reports} />
    <Fragment set:html={faq} />
    <Fragment set:html={roadmap} />
    <Cta />
  </main>

  <Footer />

  <script is:inline set:html={brailleJs} />
  <script is:inline set:html={chartsJs} />
</Base>
